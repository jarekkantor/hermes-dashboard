# Dashboard authentication secret (required)
DASHBOARD_SECRET=change-me-to-a-strong-secret

# Hermes home directory (default: ~/.hermes)
HERMES_HOME=/root/.hermes

# Dashboard database path (default: alongside app)
DASHBOARD_DB=/root/hermes-dashboard/dashboard.db

# Cost alert thresholds (USD) — set to 0 to disable
ALERT_DAILY_USD=25
ALERT_WEEKLY_USD=100
ALERT_MONTHLY_USD=300

# Session cookie TTL in days
SESSION_TTL_DAYS=7
